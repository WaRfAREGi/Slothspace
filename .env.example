# SlothSpace environment template
# Copy to .env for a local server/build pipeline. Never commit .env.

# Supabase public browser configuration.
# Use only the anon key in the browser. Never expose the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Local Ollama configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional Gemini configuration
# Only use a restricted development key. For production, use a backend proxy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional OpenAI-compatible configuration
OPENAI_COMPATIBLE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
